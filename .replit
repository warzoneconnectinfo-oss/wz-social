run = "npm run dev -- --host 0.0.0.0 --port 5173"
entrypoint = "src/main.jsx"

[nix]
channel = "stable-23_11"

[env]
VITE_SUPABASE_URL = "https://ucyrciribqaxhutjlfpj.supabase.co"

